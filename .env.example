# Copy this file to .env and fill in real values
# cp .env.example .env
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
DB_PORT=15432

# --- Prisma ---
# Full connection string for Prisma. Values must match the POSTGRES_* vars above.
# This file does NOT expand ${VARIABLES}, so the values are written literally.
DATABASE_URL="postgresql://tailoring:change_me@localhost:15432/tailoring_nb?schema=public"