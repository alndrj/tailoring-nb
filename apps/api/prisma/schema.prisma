// This file is the single source of truth about the database structure.
// Nothing is ever created directly in the database by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tailoring workshop. This is the root of the multi-tenant tree:
/// every customer, order and fabric belongs to exactly one workshop.
model Workshop {
  /// Public identifier, safe to expose in URLs.
  id        String   @id @default(uuid()) @db.Uuid

  /// Display name, as the owner writes it. Not unique: two unrelated
  /// workshops may legitimately share a name.
  name      String   @db.VarChar(120)

  /// Set once, on insert. Never changes.
  createdAt DateTime @default(now())   @db.Timestamptz(3)

  /// Refreshed by Prisma on every update.
  updatedAt DateTime @updatedAt        @db.Timestamptz(3)

  @@map("workshops")
}