{
  "name": "tailoring-nb",
  "version": "0.1.0",
  "private": true,
  "description": "Digital notebook for tailors",
  "scripts": {
    "hello": "echo Monorepo is alive",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U tailoring -d tailoring_nb",
    "db:reset": "docker compose down -v && docker compose up -d",
    "api:dev": "pnpm --filter @tailoring/api run dev",
    "api:build": "pnpm --filter @tailoring/api run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
